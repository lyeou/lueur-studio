{
  "name": "lueur-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Static Lueur Studio website with a bundled React shop carousel for GitHub Pages",
  "scripts": {
    "lint": "node --check site/homepage.js && python3 scripts/check_site.py",
    "build": "npm run build:carousel && python3 scripts/build_site.py",
    "build:carousel": "node scripts/build_shop_carousel.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
